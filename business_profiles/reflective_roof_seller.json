{
  "id": "reflective_roof_seller",
  "label": "Reflective roof coating seller",
  "description": "Specialized flow to qualify an exposed roof and simulate adding a reflective coating against heat.",
  "allowed_adaptations": ["reflective_roof"],
  "default_adaptation": "reflective_roof",
  "include_annual_experiment": true,
  "questionnaire": {
    "version": "0.1",
    "sections": [
      {
        "id": "project",
        "label": "Project",
        "questions": [
          {"id": "project_name", "type": "text", "label": "Project name", "required": true},
          {"id": "city", "type": "text", "label": "City", "required": true},
          {"id": "postal_code", "type": "text", "label": "Postal code", "required": true}
        ]
      },
      {
        "id": "dwelling",
        "label": "Home",
        "questions": [
          {
            "id": "dwelling_type",
            "type": "select",
            "label": "Home type",
            "required": true,
            "options": [
              {"id": "house", "label": "House"},
              {"id": "apartment", "label": "Apartment"}
            ]
          },
          {
            "id": "position_id",
            "type": "select",
            "label": "Home position",
            "required": true,
            "options": [
              {"id": "single_storey_house", "label": "Single-storey house"},
              {"id": "multi_storey_house", "label": "Multi-storey house"},
              {"id": "apartment_top_floor", "label": "Top-floor apartment"},
              {"id": "apartment_ground_top_floor", "label": "Ground-floor apartment directly under the roof"}
            ]
          },
          {
            "id": "period_id",
            "type": "select",
            "label": "Construction or renovation period",
            "required": true,
            "options_ref": "envelope_defaults"
          },
          {
            "id": "has_cooling",
            "type": "boolean",
            "label": "Does the home already have active cooling?",
            "required": false,
            "default": false
          },
          {
            "id": "cooling_setpoint_day_c",
            "type": "number",
            "label": "Daytime cooling setpoint (°C)",
            "required": false,
            "default": 26.0
          },
          {
            "id": "cooling_setpoint_night_c",
            "type": "number",
            "label": "Night cooling setpoint (°C)",
            "required": false,
            "default": 26.0
          },
          {
            "id": "airtightness_id",
            "type": "select",
            "label": "Overall airtightness",
            "required": true,
            "options": [
              {"id": "leaky", "label": "Noticeable drafts"},
              {"id": "standard", "label": "I don't know / nothing specific"},
              {"id": "good", "label": "Fairly airtight home"}
            ]
          },
          {
            "id": "ventilation_id",
            "type": "select",
            "label": "Main ventilation",
            "required": true,
            "options": [
              {"id": "natural_leaky_old", "label": "Natural ventilation in an older home"},
              {"id": "natural_average", "label": "Average natural ventilation"},
              {"id": "simple_flow", "label": "Single-flow mechanical ventilation"},
              {"id": "double_flow_standard", "label": "Dual-flow mechanical ventilation"},
              {"id": "airtight_recent", "label": "Recent airtight home"}
            ]
          }
        ]
      },
      {
        "id": "roof",
        "label": "Roof",
        "questions": [
          {
            "id": "roof_insulation_id",
            "type": "select",
            "label": "Current roof insulation level",
            "required": true,
            "options": [
              {"id": "poor", "label": "Roof or attic with weak insulation"},
              {"id": "standard", "label": "Standard roof insulation"},
              {"id": "renovated", "label": "Well-insulated or renovated roof"},
              {"id": "unknown", "label": "I don't know"}
            ]
          },
          {
            "id": "roof_color_id",
            "type": "select",
            "label": "Current dominant roof color",
            "required": true,
            "options": [
              {"id": "dark", "label": "Dark"},
              {"id": "medium", "label": "Medium"},
              {"id": "light", "label": "Light"},
              {"id": "unknown", "label": "I don't know"}
            ]
          },
          {
            "id": "attic_ventilation_id",
            "type": "select",
            "label": "Roof configuration above the home",
            "required": true,
            "options": [
              {"id": "attic", "label": "Attic above the home"},
              {"id": "sloped_ceiling", "label": "Sloped roof above the home"},
              {"id": "flat_roof", "label": "Flat roof above the home"}
            ]
          }
        ]
      },
      {
        "id": "rooms",
        "label": "Rooms under the roof",
        "questions": [
          {"id": "rooms", "type": "room_list", "label": "Rooms to model, with roof contact", "required": true}
        ]
      }
    ]
  }
}
