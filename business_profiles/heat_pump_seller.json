{
  "id": "heat_pump_seller",
  "label": "Vendeur de PAC",
  "description": "Parcours specialise pour qualifier un logement et simuler le remplacement du chauffage actuel par une PAC.",
  "allowed_adaptations": ["heat_pump"],
  "default_adaptation": "heat_pump",
  "include_annual_experiment": false,
  "questionnaire": {
    "version": "0.1",
    "sections": [
      {
        "id": "project",
        "label": "Projet",
        "questions": [
          {"id": "project_name", "type": "text", "label": "Nom du projet", "required": true},
          {"id": "city", "type": "text", "label": "Ville", "required": true},
          {"id": "postal_code", "type": "text", "label": "Code postal", "required": true}
        ]
      },
      {
        "id": "dwelling",
        "label": "Logement",
        "questions": [
          {
            "id": "dwelling_type",
            "type": "select",
            "label": "Type de logement",
            "required": true,
            "options": [
              {"id": "house", "label": "Maison"},
              {"id": "apartment", "label": "Appartement"}
            ]
          },
          {
            "id": "position_id",
            "type": "select",
            "label": "Position du logement",
            "required": true,
            "options": [
              {"id": "single_storey_house", "label": "Maison de plain-pied"},
              {"id": "multi_storey_house", "label": "Maison avec etage"},
              {"id": "apartment_ground_floor", "label": "Appartement en rez-de-chaussee"},
              {"id": "apartment_middle_floor", "label": "Appartement en etage intermediaire"},
              {"id": "apartment_top_floor", "label": "Appartement au dernier etage"}
            ]
          },
          {
            "id": "period_id",
            "type": "select",
            "label": "Periode de construction ou renovation",
            "required": true,
            "options_ref": "envelope_defaults"
          },
          {
            "id": "wall_insulation_id",
            "type": "select",
            "label": "Isolation des murs donnant dehors",
            "required": true,
            "options": [
              {"id": "poor", "label": "Non, ou probablement pas isoles"},
              {"id": "standard", "label": "Je ne sais pas / standard pour l'age du logement"},
              {"id": "renovated", "label": "Oui, isolation ajoutee ou renovee"}
            ]
          },
          {
            "id": "airtightness_id",
            "type": "select",
            "label": "Ressentez-vous des courants d'air ?",
            "required": true,
            "options": [
              {"id": "leaky", "label": "Oui, courants d'air sensibles aux fenetres, portes ou prises"},
              {"id": "standard", "label": "Je ne sais pas / rien de particulier"},
              {"id": "good", "label": "Non, logement plutot etanche"}
            ]
          },
          {
            "id": "ventilation_id",
            "type": "select",
            "label": "Ventilation principale",
            "required": true,
            "options": [
              {"id": "natural_leaky_old", "label": "Ventilation naturelle logement ancien"},
              {"id": "natural_average", "label": "Ventilation naturelle moyenne"},
              {"id": "simple_flow", "label": "VMC simple flux"},
              {"id": "double_flow_standard", "label": "VMC double flux"},
              {"id": "airtight_recent", "label": "Logement recent etanche"}
            ]
          }
        ]
      },
      {
        "id": "heating",
        "label": "Chauffage actuel",
        "questions": [
          {
            "id": "current_energy_id",
            "type": "select",
            "label": "Energie actuelle du chauffage",
            "required": true,
            "options": [
              {"id": "electricity", "label": "Electricite"},
              {"id": "gas", "label": "Gaz"},
              {"id": "fuel_oil", "label": "Fioul"},
              {"id": "wood", "label": "Bois"},
              {"id": "unknown", "label": "Je ne sais pas"}
            ]
          },
          {
            "id": "heat_emitters_id",
            "type": "select",
            "label": "Diffusion de chaleur actuelle",
            "required": true,
            "options": [
              {"id": "electric_radiators", "label": "Radiateurs electriques"},
              {"id": "water_radiators", "label": "Radiateurs a eau"},
              {"id": "underfloor", "label": "Plancher chauffant"},
              {"id": "air_units", "label": "Unites murales / soufflage d'air"},
              {"id": "mixed", "label": "Mixte ou incertain"}
            ]
          },
          {"id": "heating_setpoint_c", "type": "number", "label": "Temperature de chauffage visee en hiver", "required": true, "default": 19.0}
        ]
      },
      {
        "id": "rooms",
        "label": "Pieces",
        "questions": [
          {"id": "rooms", "type": "room_list", "label": "Pieces a modeliser", "required": true}
        ]
      }
    ]
  }
}
