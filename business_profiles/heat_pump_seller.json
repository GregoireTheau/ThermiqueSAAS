{
  "id": "heat_pump_seller",
  "label": "Heat pump seller",
  "description": "Specialized flow to qualify a home and simulate replacing the current heating system with a heat pump.",
  "allowed_adaptations": ["heat_pump"],
  "default_adaptation": "heat_pump",
  "include_annual_experiment": true,
  "questionnaire": {
    "version": "0.1",
    "sections": [
      {
        "id": "project",
        "label": "Project",
        "questions": [
          {"id": "project_name", "type": "text", "label": "Project name", "required": true},
          {"id": "city", "type": "text", "label": "City", "required": true},
          {"id": "postal_code", "type": "text", "label": "Postal code", "required": true}
        ]
      },
      {
        "id": "dwelling",
        "label": "Home",
        "questions": [
          {
            "id": "dwelling_type",
            "type": "select",
            "label": "Home type",
            "required": true,
            "options": [
              {"id": "house", "label": "House"},
              {"id": "apartment", "label": "Apartment"}
            ]
          },
          {
            "id": "position_id",
            "type": "select",
            "label": "Home position",
            "required": true,
            "options": [
              {"id": "single_storey_house", "label": "Single-storey house"},
              {"id": "multi_storey_house", "label": "Multi-storey house"},
              {"id": "apartment_ground_floor", "label": "Ground-floor apartment"},
              {"id": "apartment_middle_floor", "label": "Middle-floor apartment"},
              {"id": "apartment_top_floor", "label": "Top-floor apartment"}
            ]
          },
          {
            "id": "period_id",
            "type": "select",
            "label": "Construction or renovation period",
            "required": true,
            "options_ref": "envelope_defaults"
          },
          {
            "id": "wall_insulation_id",
            "type": "select",
            "label": "Insulation of exterior walls",
            "required": true,
            "options": [
              {"id": "poor", "label": "No, or probably not insulated"},
              {"id": "standard", "label": "I don't know / typical for the home's age"},
              {"id": "renovated", "label": "Yes, insulation added or renovated"}
            ]
          },
          {
            "id": "airtightness_id",
            "type": "select",
            "label": "Do you feel drafts?",
            "required": true,
            "options": [
              {"id": "leaky", "label": "Yes, noticeable drafts around windows, doors, or outlets"},
              {"id": "standard", "label": "I don't know / nothing specific"},
              {"id": "good", "label": "No, fairly airtight home"}
            ]
          },
          {
            "id": "ventilation_id",
            "type": "select",
            "label": "Main ventilation",
            "required": true,
            "options": [
              {"id": "natural_leaky_old", "label": "Natural ventilation in an older home"},
              {"id": "natural_average", "label": "Average natural ventilation"},
              {"id": "simple_flow", "label": "Single-flow mechanical ventilation"},
              {"id": "double_flow_standard", "label": "Dual-flow mechanical ventilation"},
              {"id": "airtight_recent", "label": "Recent airtight home"}
            ]
          },
          {
            "id": "has_cooling",
            "type": "boolean",
            "label": "Does the home already have active cooling?",
            "required": false,
            "default": false
          }
        ]
      },
      {
        "id": "heating",
        "label": "Current heating",
        "questions": [
          {
            "id": "current_energy_id",
            "type": "select",
            "label": "Current heating energy",
            "required": true,
            "options": [
              {"id": "electricity", "label": "Electricity"},
              {"id": "gas", "label": "Gaz"},
              {"id": "fuel_oil", "label": "Oil"},
              {"id": "wood", "label": "Wood"},
              {"id": "unknown", "label": "I don't know"}
            ]
          },
          {
            "id": "heat_emitters_id",
            "type": "select",
            "label": "Current heat distribution",
            "required": true,
            "options": [
              {"id": "electric_radiators", "label": "Electric radiators"},
              {"id": "water_radiators", "label": "Water radiators"},
              {"id": "underfloor", "label": "Underfloor heating"},
              {"id": "air_units", "label": "Wall units / air supply"},
              {"id": "mixed", "label": "Mixed or uncertain"}
            ]
          },
          {"id": "heating_setpoint_c", "type": "number", "label": "Target winter heating temperature", "required": true, "default": 19.0}
        ]
      },
      {
        "id": "rooms",
        "label": "Rooms",
        "questions": [
          {"id": "rooms", "type": "room_list", "label": "Rooms to model", "required": true}
        ]
      }
    ]
  }
}
