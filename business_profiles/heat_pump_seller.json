{
  "id": "heat_pump_seller",
  "label": "Vendeur de PAC",
  "description": "Parcours spécialisé pour qualifier un logement et simuler le remplacement du chauffage actuel par une PAC.",
  "allowed_adaptations": ["heat_pump"],
  "default_adaptation": "heat_pump",
  "include_annual_experiment": true,
  "questionnaire": {
    "version": "0.1",
    "sections": [
      {
        "id": "project",
        "label": "Projet",
        "questions": [
          {"id": "project_name", "type": "text", "label": "Nom du projet", "required": true},
          {"id": "city", "type": "text", "label": "Ville", "required": true},
          {"id": "postal_code", "type": "text", "label": "Code postal", "required": true}
        ]
      },
      {
        "id": "dwelling",
        "label": "Logement",
        "questions": [
          {
            "id": "dwelling_type",
            "type": "select",
            "label": "Type de logement",
            "required": true,
            "options": [
              {"id": "house", "label": "Maison"},
              {"id": "apartment", "label": "Appartement"}
            ]
          },
          {
            "id": "position_id",
            "type": "select",
            "label": "Position du logement",
            "required": true,
            "options": [
              {"id": "single_storey_house", "label": "Maison de plain-pied"},
              {"id": "multi_storey_house", "label": "Maison avec étage"},
              {"id": "apartment_ground_floor", "label": "Appartement en rez-de-chaussée"},
              {"id": "apartment_middle_floor", "label": "Appartement en étage intermédiaire"},
              {"id": "apartment_top_floor", "label": "Appartement au dernier étage"}
            ]
          },
          {
            "id": "period_id",
            "type": "select",
            "label": "Période de construction ou rénovation",
            "required": true,
            "options_ref": "envelope_defaults"
          },
          {
            "id": "wall_insulation_id",
            "type": "select",
            "label": "Isolation des murs donnant dehors",
            "required": true,
            "options": [
              {"id": "poor", "label": "Non, ou probablement pas isolés"},
              {"id": "standard", "label": "Je ne sais pas / standard pour l'âge du logement"},
              {"id": "renovated", "label": "Oui, isolation ajoutée ou rénovée"}
            ]
          },
          {
            "id": "airtightness_id",
            "type": "select",
            "label": "Ressentez-vous des courants d'air ?",
            "required": true,
            "options": [
              {"id": "leaky", "label": "Oui, courants d'air sensibles aux fenêtres, portes ou prises"},
              {"id": "standard", "label": "Je ne sais pas / rien de particulier"},
              {"id": "good", "label": "Non, logement plutôt étanche"}
            ]
          },
          {
            "id": "ventilation_id",
            "type": "select",
            "label": "Ventilation principale",
            "required": true,
            "options": [
              {"id": "natural_leaky_old", "label": "Ventilation naturelle logement ancien"},
              {"id": "natural_average", "label": "Ventilation naturelle moyenne"},
              {"id": "simple_flow", "label": "VMC simple flux"},
              {"id": "double_flow_standard", "label": "VMC double flux"},
              {"id": "airtight_recent", "label": "Logement récent étanche"}
            ]
          },
          {
            "id": "has_cooling",
            "type": "boolean",
            "label": "Le logement a-t-il déjà une climatisation active ?",
            "required": false,
            "default": false
          }
        ]
      },
      {
        "id": "heating",
        "label": "Chauffage actuel",
        "questions": [
          {
            "id": "current_energy_id",
            "type": "select",
            "label": "Énergie actuelle du chauffage",
            "required": true,
            "options": [
              {"id": "electricity", "label": "Électricité"},
              {"id": "gas", "label": "Gaz"},
              {"id": "fuel_oil", "label": "Fioul"},
              {"id": "wood", "label": "Bois"},
              {"id": "unknown", "label": "Je ne sais pas"}
            ]
          },
          {
            "id": "heat_emitters_id",
            "type": "select",
            "label": "Diffusion de chaleur actuelle",
            "required": true,
            "options": [
              {"id": "electric_radiators", "label": "Radiateurs électriques"},
              {"id": "water_radiators", "label": "Radiateurs à eau"},
              {"id": "underfloor", "label": "Plancher chauffant"},
              {"id": "air_units", "label": "Unités murales / soufflage d'air"},
              {"id": "mixed", "label": "Mixte ou incertain"}
            ]
          },
          {"id": "heating_setpoint_c", "type": "number", "label": "Température de chauffage visée en hiver", "required": true, "default": 19.0}
        ]
      },
      {
        "id": "rooms",
        "label": "Pièces",
        "questions": [
          {"id": "rooms", "type": "room_list", "label": "Pièces à modéliser", "required": true}
        ]
      }
    ]
  }
}
