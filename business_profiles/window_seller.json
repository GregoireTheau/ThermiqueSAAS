{
  "id": "window_seller",
  "label": "Vendeur de fenêtres",
  "description": "Parcours spécialisé pour qualifier les vitrages existants et simuler le remplacement par du double vitrage performant.",
  "allowed_adaptations": ["better_windows"],
  "default_adaptation": "better_windows",
  "include_annual_experiment": true,
  "questionnaire": {
    "version": "0.1",
    "sections": [
      {
        "id": "project",
        "label": "Projet",
        "questions": [
          {"id": "project_name", "type": "text", "label": "Nom du projet", "required": true},
          {"id": "city", "type": "text", "label": "Ville", "required": true},
          {"id": "postal_code", "type": "text", "label": "Code postal", "required": true}
        ]
      },
      {
        "id": "dwelling",
        "label": "Logement",
        "questions": [
          {
            "id": "dwelling_type",
            "type": "select",
            "label": "Type de logement",
            "required": true,
            "options": [
              {"id": "house", "label": "Maison"},
              {"id": "apartment", "label": "Appartement"}
            ]
          },
          {
            "id": "position_id",
            "type": "select",
            "label": "Position du logement",
            "required": true,
            "options": [
              {"id": "single_storey_house", "label": "Maison de plain-pied"},
              {"id": "multi_storey_house", "label": "Maison avec étage"},
              {"id": "apartment_ground_floor", "label": "Appartement en rez-de-chaussée"},
              {"id": "apartment_middle_floor", "label": "Appartement en étage intermédiaire"},
              {"id": "apartment_top_floor", "label": "Appartement au dernier étage"}
            ]
          },
          {
            "id": "period_id",
            "type": "select",
            "label": "Période de construction ou rénovation",
            "required": true,
            "options_ref": "envelope_defaults"
          },
          {
            "id": "has_cooling",
            "type": "boolean",
            "label": "Le logement a-t-il déjà une climatisation active ?",
            "required": false,
            "default": false
          },
          {
            "id": "ventilation_id",
            "type": "select",
            "label": "Ventilation principale",
            "required": true,
            "options": [
              {"id": "natural_leaky_old", "label": "Ventilation naturelle logement ancien"},
              {"id": "natural_average", "label": "Ventilation naturelle moyenne"},
              {"id": "simple_flow", "label": "VMC simple flux"},
              {"id": "double_flow_standard", "label": "VMC double flux"},
              {"id": "airtight_recent", "label": "Logement récent étanche"}
            ]
          },
          {
            "id": "wall_insulation_id",
            "type": "select",
            "label": "Isolation des murs donnant dehors",
            "required": true,
            "options": [
              {"id": "poor", "label": "Non, ou probablement pas isolés"},
              {"id": "standard", "label": "Je ne sais pas / standard pour l'âge du logement"},
              {"id": "renovated", "label": "Oui, isolation ajoutée ou rénovée"}
            ]
          },
          {
            "id": "airtightness_id",
            "type": "select",
            "label": "Étanchéité globale du logement",
            "required": true,
            "options": [
              {"id": "leaky", "label": "Courants d'air sensibles"},
              {"id": "standard", "label": "Je ne sais pas / rien de particulier"},
              {"id": "good", "label": "Logement plutôt étanche"}
            ]
          }
        ]
      },
      {
        "id": "windows",
        "label": "Vitrages actuels",
        "questions": [
          {
            "id": "window_ref",
            "type": "select",
            "label": "Type de vitrage principal",
            "required": true,
            "options": [
              {"id": "single_glazing_old", "label": "Simple vitrage"},
              {"id": "double_glazing_old", "label": "Double vitrage ancien"},
              {"id": "double_glazing_standard", "label": "Double vitrage récent standard"}
            ]
          },
          {
            "id": "window_air_leakage_id",
            "type": "select",
            "label": "Infiltrations d'air autour des fenêtres",
            "required": true,
            "options": [
              {"id": "leaky", "label": "Oui, courants d'air sensibles"},
              {"id": "standard", "label": "Je ne sais pas / rien de particulier"},
              {"id": "good", "label": "Non, logement plutôt étanche"}
            ]
          }
        ]
      },
      {
        "id": "rooms",
        "label": "Pièces et vitrages",
        "questions": [
          {"id": "rooms", "type": "room_list", "label": "Pièces à modéliser avec orientations et surfaces vitrées", "required": true}
        ]
      }
    ]
  }
}
