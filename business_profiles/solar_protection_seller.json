{
  "id": "solar_protection_seller",
  "label": "Vendeur de protections solaires",
  "description": "Parcours specialise pour qualifier les vitrages exposes et simuler l'ajout de volets ou protections solaires.",
  "allowed_adaptations": ["solar_protection"],
  "default_adaptation": "solar_protection",
  "include_annual_experiment": true,
  "questionnaire": {
    "version": "0.1",
    "sections": [
      {
        "id": "project",
        "label": "Projet",
        "questions": [
          {"id": "project_name", "type": "text", "label": "Nom du projet", "required": true},
          {"id": "city", "type": "text", "label": "Ville", "required": true},
          {"id": "postal_code", "type": "text", "label": "Code postal", "required": true}
        ]
      },
      {
        "id": "dwelling",
        "label": "Logement",
        "questions": [
          {
            "id": "dwelling_type",
            "type": "select",
            "label": "Type de logement",
            "required": true,
            "options": [
              {"id": "house", "label": "Maison"},
              {"id": "apartment", "label": "Appartement"}
            ]
          },
          {
            "id": "position_id",
            "type": "select",
            "label": "Position du logement",
            "required": true,
            "options": [
              {"id": "single_storey_house", "label": "Maison de plain-pied"},
              {"id": "multi_storey_house", "label": "Maison avec etage"},
              {"id": "apartment_ground_floor", "label": "Appartement en rez-de-chaussee"},
              {"id": "apartment_middle_floor", "label": "Appartement en etage intermediaire"},
              {"id": "apartment_top_floor", "label": "Appartement au dernier etage"}
            ]
          },
          {
            "id": "period_id",
            "type": "select",
            "label": "Periode de construction ou renovation",
            "required": true,
            "options_ref": "envelope_defaults"
          },
          {
            "id": "has_cooling",
            "type": "boolean",
            "label": "Le logement a-t-il deja une climatisation active ?",
            "required": false,
            "default": false
          },
          {
            "id": "airtightness_id",
            "type": "select",
            "label": "Etancheite globale du logement",
            "required": true,
            "options": [
              {"id": "leaky", "label": "Courants d'air sensibles"},
              {"id": "standard", "label": "Je ne sais pas / rien de particulier"},
              {"id": "good", "label": "Logement plutot etanche"}
            ]
          },
          {
            "id": "ventilation_id",
            "type": "select",
            "label": "Ventilation principale",
            "required": true,
            "options": [
              {"id": "natural_leaky_old", "label": "Ventilation naturelle logement ancien"},
              {"id": "natural_average", "label": "Ventilation naturelle moyenne"},
              {"id": "simple_flow", "label": "VMC simple flux"},
              {"id": "double_flow_standard", "label": "VMC double flux"},
              {"id": "airtight_recent", "label": "Logement recent etanche"}
            ]
          },
          {
            "id": "wall_insulation_id",
            "type": "select",
            "label": "Isolation des murs donnant dehors",
            "required": true,
            "options": [
              {"id": "poor", "label": "Non, ou probablement pas isoles"},
              {"id": "standard", "label": "Je ne sais pas / standard pour l'age du logement"},
              {"id": "renovated", "label": "Oui, isolation ajoutee ou renovee"}
            ]
          }
        ]
      },
      {
        "id": "summer_comfort",
        "label": "Confort d'ete",
        "questions": [
          {
            "id": "window_ref",
            "type": "select",
            "label": "Type de vitrage principal",
            "required": true,
            "options": [
              {"id": "single_glazing_old", "label": "Simple vitrage"},
              {"id": "double_glazing_old", "label": "Double vitrage ancien"},
              {"id": "double_glazing_standard", "label": "Double vitrage recent standard"},
              {"id": "double_glazing_low_e", "label": "Double vitrage performant"}
            ]
          },
          {
            "id": "shutter_ref",
            "type": "select",
            "label": "Protection solaire actuelle",
            "required": true,
            "options": [
              {"id": "none", "label": "Pas de volet/protection"},
              {"id": "roller_shutter_standard", "label": "Volets roulants ou battants"},
              {"id": "external_blind", "label": "Stores exterieurs"},
              {"id": "interior_blind", "label": "Stores interieurs"}
            ]
          },
          {
            "id": "shutter_usage_id",
            "type": "select",
            "label": "Usage actuel des volets/stores en ete",
            "required": true,
            "options": [
              {"id": "day_closed", "label": "Fermes en journee quand il fait chaud"},
              {"id": "partial", "label": "Partiellement fermes ou selon presence"},
              {"id": "rare", "label": "Rarement fermes en journee"}
            ]
          },
          {"id": "cooling_setpoint_c", "type": "number", "label": "Temperature de confort ete visee", "required": true, "default": 26.0}
        ]
      },
      {
        "id": "rooms",
        "label": "Pieces et vitrages exposes",
        "questions": [
          {"id": "rooms", "type": "room_list", "label": "Pieces a modeliser avec orientations et surfaces vitrees", "required": true}
        ]
      }
    ]
  }
}
