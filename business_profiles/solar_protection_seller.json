{
  "id": "solar_protection_seller",
  "label": "Solar protection seller",
  "description": "Specialized flow to qualify exposed glazing and simulate adding shutters or solar protection.",
  "allowed_adaptations": ["solar_protection"],
  "default_adaptation": "solar_protection",
  "include_annual_experiment": true,
  "questionnaire": {
    "version": "0.1",
    "sections": [
      {
        "id": "project",
        "label": "Project",
        "questions": [
          {"id": "project_name", "type": "text", "label": "Project name", "required": true},
          {"id": "city", "type": "text", "label": "City", "required": true},
          {"id": "postal_code", "type": "text", "label": "Postal code", "required": true}
        ]
      },
      {
        "id": "dwelling",
        "label": "Home",
        "questions": [
          {
            "id": "dwelling_type",
            "type": "select",
            "label": "Home type",
            "required": true,
            "options": [
              {"id": "house", "label": "House"},
              {"id": "apartment", "label": "Apartment"}
            ]
          },
          {
            "id": "position_id",
            "type": "select",
            "label": "Home position",
            "required": true,
            "options": [
              {"id": "single_storey_house", "label": "Single-storey house"},
              {"id": "multi_storey_house", "label": "Multi-storey house"},
              {"id": "apartment_ground_floor", "label": "Ground-floor apartment"},
              {"id": "apartment_middle_floor", "label": "Middle-floor apartment"},
              {"id": "apartment_top_floor", "label": "Top-floor apartment"}
            ]
          },
          {
            "id": "period_id",
            "type": "select",
            "label": "Construction or renovation period",
            "required": true,
            "options_ref": "envelope_defaults"
          },
          {
            "id": "has_cooling",
            "type": "boolean",
            "label": "Does the home already have active cooling?",
            "required": false,
            "default": false
          },
          {
            "id": "airtightness_id",
            "type": "select",
            "label": "Overall airtightness",
            "required": true,
            "options": [
              {"id": "leaky", "label": "Noticeable drafts"},
              {"id": "standard", "label": "I don't know / nothing specific"},
              {"id": "good", "label": "Fairly airtight home"}
            ]
          },
          {
            "id": "ventilation_id",
            "type": "select",
            "label": "Main ventilation",
            "required": true,
            "options": [
              {"id": "natural_leaky_old", "label": "Natural ventilation in an older home"},
              {"id": "natural_average", "label": "Average natural ventilation"},
              {"id": "simple_flow", "label": "Single-flow mechanical ventilation"},
              {"id": "double_flow_standard", "label": "Dual-flow mechanical ventilation"},
              {"id": "airtight_recent", "label": "Recent airtight home"}
            ]
          },
          {
            "id": "wall_insulation_id",
            "type": "select",
            "label": "Insulation of exterior walls",
            "required": true,
            "options": [
              {"id": "poor", "label": "No, or probably not insulated"},
              {"id": "standard", "label": "I don't know / typical for the home's age"},
              {"id": "renovated", "label": "Yes, insulation added or renovated"}
            ]
          }
        ]
      },
      {
        "id": "summer_comfort",
        "label": "Summer comfort",
        "questions": [
          {
            "id": "window_ref",
            "type": "select",
            "label": "Main glazing type",
            "required": true,
            "options": [
              {"id": "single_glazing_old", "label": "Single glazing"},
              {"id": "double_glazing_old", "label": "Old double glazing"},
              {"id": "double_glazing_standard", "label": "Recent standard double glazing"},
              {"id": "double_glazing_low_e", "label": "High-performance double glazing"}
            ]
          },
          {
            "id": "shutter_ref",
            "type": "select",
            "label": "Current solar protection",
            "required": true,
            "options": [
              {"id": "none", "label": "No shutter/protection"},
              {"id": "roller_shutter_standard", "label": "Roller or hinged shutters"},
              {"id": "external_blind", "label": "External blinds"},
              {"id": "interior_blind", "label": "Interior blinds"}
            ]
          },
          {
            "id": "shutter_usage_id",
            "type": "select",
            "label": "Current shutter/blind use in summer",
            "required": true,
            "options": [
              {"id": "day_closed", "label": "Closed during the day when it is hot"},
              {"id": "partial", "label": "Partly closed or depending on occupancy"},
              {"id": "rare", "label": "Rarely closed during the day"}
            ]
          },
          {"id": "cooling_setpoint_c", "type": "number", "label": "Target summer comfort temperature", "required": true, "default": 26.0}
        ]
      },
      {
        "id": "rooms",
        "label": "Rooms and exposed glazing",
        "questions": [
          {"id": "rooms", "type": "room_list", "label": "Rooms to model with orientations and glazed areas", "required": true}
        ]
      }
    ]
  }
}
