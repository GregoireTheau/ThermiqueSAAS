{
  "id": "roof_insulation_seller",
  "label": "Isolation toiture",
  "description": "Parcours spécialisé pour qualifier une toiture ou des combles et simuler l'amélioration de l'isolation avant/après travaux.",
  "allowed_adaptations": ["roof_insulation"],
  "default_adaptation": "roof_insulation",
  "include_annual_experiment": true,
  "questionnaire": {
    "version": "0.1",
    "sections": [
      {
        "id": "project",
        "label": "Projet",
        "questions": [
          {"id": "project_name", "type": "text", "label": "Nom du projet", "required": true},
          {"id": "city", "type": "text", "label": "Ville", "required": true},
          {"id": "postal_code", "type": "text", "label": "Code postal", "required": true}
        ]
      },
      {
        "id": "dwelling",
        "label": "Logement",
        "questions": [
          {
            "id": "dwelling_type",
            "type": "select",
            "label": "Type de logement",
            "required": true,
            "options": [
              {"id": "house", "label": "Maison"},
              {"id": "apartment", "label": "Appartement"}
            ]
          },
          {
            "id": "position_id",
            "type": "select",
            "label": "Position du logement",
            "required": true,
            "options": [
              {"id": "single_storey_house", "label": "Maison de plain-pied"},
              {"id": "multi_storey_house", "label": "Maison avec étage"},
              {"id": "apartment_top_floor", "label": "Appartement au dernier étage"},
              {"id": "apartment_ground_top_floor", "label": "Appartement en rez-de-chaussée directement sous toiture"}
            ]
          },
          {
            "id": "wall_insulation_id",
            "type": "select",
            "label": "Isolation des murs donnant dehors",
            "required": true,
            "options": [
              {"id": "poor", "label": "Non, ou probablement pas isolés"},
              {"id": "standard", "label": "Je ne sais pas / standard pour l'âge du logement"},
              {"id": "renovated", "label": "Oui, isolation ajoutée ou rénovée"}
            ]
          },
          {
            "id": "period_id",
            "type": "select",
            "label": "Période de construction ou rénovation",
            "required": true,
            "options_ref": "envelope_defaults"
          },
          {
            "id": "has_cooling",
            "type": "boolean",
            "label": "Le logement a-t-il déjà une climatisation active ?",
            "required": false,
            "default": false
          },
          {
            "id": "heating_ref",
            "type": "select",
            "label": "Chauffage principal actuel",
            "required": true,
            "options": [
              {"id": "electric_radiator", "label": "Radiateurs électriques"},
              {"id": "gas_boiler_standard", "label": "Chaudière gaz"},
              {"id": "fuel_oil_boiler_standard", "label": "Chaudière fioul"},
              {"id": "wood_stove_standard", "label": "Chauffage bois"},
              {"id": "air_air_heat_pump_standard", "label": "PAC air-air"},
              {"id": "air_water_heat_pump_standard", "label": "PAC air-eau"}
            ]
          },
          {
            "id": "heating_setpoint_c",
            "type": "number",
            "label": "Consigne de chauffage habituelle (°C)",
            "required": false,
            "default": 19.0
          },
          {
            "id": "cooling_setpoint_day_c",
            "type": "number",
            "label": "Consigne de climatisation en journée (°C)",
            "required": false,
            "default": 26.0
          },
          {
            "id": "cooling_setpoint_night_c",
            "type": "number",
            "label": "Consigne de climatisation la nuit (°C)",
            "required": false,
            "default": 26.0
          },
          {
            "id": "airtightness_id",
            "type": "select",
            "label": "Étanchéité globale du logement",
            "required": true,
            "options": [
              {"id": "leaky", "label": "Courants d'air sensibles"},
              {"id": "standard", "label": "Je ne sais pas / rien de particulier"},
              {"id": "good", "label": "Logement plutôt étanche"}
            ]
          },
          {
            "id": "ventilation_id",
            "type": "select",
            "label": "Ventilation principale",
            "required": true,
            "options": [
              {"id": "natural_leaky_old", "label": "Ventilation naturelle logement ancien"},
              {"id": "natural_average", "label": "Ventilation naturelle moyenne"},
              {"id": "simple_flow", "label": "VMC simple flux"},
              {"id": "double_flow_standard", "label": "VMC double flux"},
              {"id": "airtight_recent", "label": "Logement récent étanche"}
            ]
          }
        ]
      },
      {
        "id": "roof",
        "label": "Toiture",
        "questions": [
          {
            "id": "roof_insulation_id",
            "type": "select",
            "label": "Niveau d'isolation toiture ou combles actuel",
            "required": true,
            "options": [
              {"id": "poor", "label": "Absente, ancienne ou très faible"},
              {"id": "standard", "label": "Isolation moyenne / standard"},
              {"id": "renovated", "label": "Isolation récente ou renforcée"},
              {"id": "unknown", "label": "Je ne sais pas"}
            ]
          },
          {
            "id": "roof_color_id",
            "type": "select",
            "label": "Couleur dominante actuelle de la toiture (impact été)",
            "required": true,
            "options": [
              {"id": "dark", "label": "Foncée"},
              {"id": "medium", "label": "Moyenne"},
              {"id": "light", "label": "Claire"},
              {"id": "unknown", "label": "Je ne sais pas"}
            ]
          },
          {
            "id": "attic_ventilation_id",
            "type": "select",
            "label": "Type de toiture ou combles au-dessus du logement",
            "required": true,
            "options": [
              {"id": "attic", "label": "Combles perdus au-dessus du logement"},
              {"id": "sloped_ceiling", "label": "Rampants / pièces sous pente"},
              {"id": "flat_roof", "label": "Toit terrasse au-dessus du logement"}
            ]
          }
        ]
      },
      {
        "id": "rooms",
        "label": "Pièces sous toiture",
        "questions": [
          {"id": "rooms", "type": "room_list", "label": "Pièces chauffées à modéliser sous toiture", "required": true}
        ]
      }
    ]
  }
}
