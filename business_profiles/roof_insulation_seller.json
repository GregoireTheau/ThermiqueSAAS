{
  "id": "roof_insulation_seller",
  "label": "Roof insulation",
  "description": "Specialized flow to qualify a roof or attic and simulate the before/after effect of improving insulation.",
  "allowed_adaptations": ["roof_insulation"],
  "default_adaptation": "roof_insulation",
  "include_annual_experiment": true,
  "questionnaire": {
    "version": "0.1",
    "sections": [
      {
        "id": "project",
        "label": "Project",
        "questions": [
          {"id": "project_name", "type": "text", "label": "Project name", "required": true},
          {"id": "postal_code", "type": "text", "label": "ZIP code", "required": true},
          {"id": "address", "type": "text", "label": "Street address (optional)", "required": false},
          {
            "id": "annual_weather_type",
            "type": "select",
            "label": "Annual weather basis",
            "required": true,
            "options": [
              {"id": "typical", "label": "Typical meteorological year (recommended)"},
              {"id": "historical", "label": "Historical weather year"}
            ]
          },
          {"id": "annual_weather_year", "type": "number", "label": "Historical weather year", "required": false, "default": 2023}
        ]
      },
      {
        "id": "dwelling",
        "label": "Home",
        "questions": [
          {
            "id": "dwelling_type",
            "type": "select",
            "label": "Home type",
            "required": true,
            "options": [
              {"id": "house", "label": "House"},
              {"id": "apartment", "label": "Apartment"}
            ]
          },
          {
            "id": "position_id",
            "type": "select",
            "label": "Home position",
            "required": true,
            "options": [
              {"id": "single_storey_house", "label": "Single-storey house"},
              {"id": "multi_storey_house", "label": "Multi-storey house"},
              {"id": "apartment_top_floor", "label": "Top-floor apartment"},
              {"id": "apartment_ground_top_floor", "label": "Ground-floor apartment directly under the roof"}
            ]
          },
          {
            "id": "wall_insulation_id",
            "type": "select",
            "label": "Insulation of exterior walls",
            "required": true,
            "options": [
              {"id": "poor", "label": "No, or probably not insulated"},
              {"id": "standard", "label": "I don't know / typical for the home's age"},
              {"id": "renovated", "label": "Yes, insulation added or renovated"}
            ]
          },
          {
            "id": "construction_era_id",
            "type": "select",
            "label": "Construction era",
            "required": true,
            "options_ref": "envelope_defaults"
          },
          {
            "id": "has_cooling",
            "type": "boolean",
            "label": "Does the home already have active cooling?",
            "required": false,
            "default": false
          },
          {
            "id": "heating_ref",
            "type": "select",
            "label": "Current main heating system",
            "required": true,
            "options": [
              {"id": "natural_gas_furnace_standard", "label": "Natural gas forced-air furnace"},
              {"id": "propane_furnace_standard", "label": "Propane forced-air furnace"},
              {"id": "air_source_heat_pump_standard", "label": "Central air-source heat pump"},
              {"id": "electric_resistance", "label": "Electric resistance heat"}
            ]
          },
          {
            "id": "heating_setpoint_f",
            "type": "number",
            "label": "Usual heating setpoint (°F)",
            "required": false,
            "default": 68
          },
          {
            "id": "electricity_price_usd_kwh",
            "type": "number",
            "label": "Electricity price ($/kWh)",
            "required": false,
            "default": 0.18
          },
          {
            "id": "natural_gas_price_usd_therm",
            "type": "number",
            "label": "Natural gas price ($/therm)",
            "required": false,
            "default": 1.5
          },
          {
            "id": "propane_price_usd_gallon",
            "type": "number",
            "label": "Propane price ($/gallon)",
            "required": false,
            "default": 2.5
          },
          {
            "id": "cooling_setpoint_day_f",
            "type": "number",
            "label": "Daytime cooling setpoint (°F)",
            "required": false,
            "default": 78
          },
          {
            "id": "cooling_setpoint_night_f",
            "type": "number",
            "label": "Night cooling setpoint (°F)",
            "required": false,
            "default": 78
          },
          {
            "id": "airtightness_id",
            "type": "select",
            "label": "Overall airtightness",
            "required": true,
            "options": [
              {"id": "leaky", "label": "Noticeable drafts"},
              {"id": "standard", "label": "I don't know / nothing specific"},
              {"id": "good", "label": "Fairly airtight home"}
            ]
          },
          {
            "id": "ventilation_id",
            "type": "select",
            "label": "Main ventilation",
            "required": true,
            "options": [
              {"id": "natural_leaky_old", "label": "Natural ventilation in an older home"},
              {"id": "natural_average", "label": "Average natural ventilation"},
              {"id": "simple_flow", "label": "Single-flow mechanical ventilation"},
              {"id": "double_flow_standard", "label": "Dual-flow mechanical ventilation"},
              {"id": "airtight_recent", "label": "Recent airtight home"}
            ]
          }
        ]
      },
      {
        "id": "roof",
        "label": "Roof",
        "questions": [
          {
            "id": "roof_assembly_id",
            "type": "select",
            "label": "Attic and roof assembly",
            "required": true,
            "options": [
              {"id": "vented_attic_ceiling", "label": "Vented attic — insulation at attic floor / ceiling"},
              {"id": "unvented_conditioned_attic_roof_deck", "label": "Unvented conditioned attic — insulation at roof deck"},
              {"id": "cathedral_ceiling_roof_deck", "label": "Cathedral ceiling — insulation at roof deck"},
              {"id": "compact_flat_roof", "label": "Compact or flat roof assembly"}
            ]
          },
          {"id": "existing_roof_r_value", "type": "number", "label": "Existing insulation R-value (US)", "required": true, "default": 19},
          {"id": "proposed_roof_r_value", "type": "number", "label": "Proposed insulation R-value (US)", "required": true, "default": 49},
          {
            "id": "framing_type_id",
            "type": "select",
            "label": "Roof framing type",
            "required": true,
            "options": [
              {"id": "wood_frame", "label": "Wood framing / trusses"},
              {"id": "steel_frame", "label": "Steel framing"},
              {"id": "masonry_concrete", "label": "Masonry or concrete"},
              {"id": "unknown", "label": "Unknown"}
            ]
          },
          {
            "id": "hvac_duct_location_id",
            "type": "select",
            "label": "HVAC duct presence and location",
            "required": true,
            "options": [
              {"id": "no_ducts", "label": "No HVAC ducts"},
              {"id": "conditioned_space", "label": "Ducts inside conditioned space"},
              {"id": "conditioned_attic", "label": "Ducts in conditioned attic"},
              {"id": "vented_attic", "label": "Ducts in vented attic"},
              {"id": "unconditioned_crawlspace", "label": "Ducts in unconditioned crawlspace"},
              {"id": "unconditioned_basement", "label": "Ducts in unconditioned basement"},
              {"id": "garage", "label": "Ducts in garage"},
              {"id": "mixed_unknown", "label": "Mixed or unknown location"}
            ]
          },
          {
            "id": "roof_color_id",
            "type": "select",
            "label": "Current dominant roof color (summer impact)",
            "required": true,
            "options": [
              {"id": "dark", "label": "Dark"},
              {"id": "medium", "label": "Medium"},
              {"id": "light", "label": "Light"},
              {"id": "unknown", "label": "I don't know"}
            ]
          }
        ]
      },
      {
        "id": "rooms",
        "label": "Rooms under the roof",
        "questions": [
          {"id": "rooms", "type": "room_list", "label": "Heated rooms under the roof to model", "required": true}
        ]
      }
    ]
  }
}
