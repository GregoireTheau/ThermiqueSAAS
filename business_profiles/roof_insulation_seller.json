{
  "id": "roof_insulation_seller",
  "label": "Vendeur isolation toiture",
  "description": "Parcours specialise pour qualifier une toiture ou des combles et simuler l'amelioration de l'isolation.",
  "allowed_adaptations": ["roof_insulation"],
  "default_adaptation": "roof_insulation",
  "include_annual_experiment": true,
  "questionnaire": {
    "version": "0.1",
    "sections": [
      {
        "id": "project",
        "label": "Projet",
        "questions": [
          {"id": "project_name", "type": "text", "label": "Nom du projet", "required": true},
          {"id": "city", "type": "text", "label": "Ville", "required": true},
          {"id": "postal_code", "type": "text", "label": "Code postal", "required": true}
        ]
      },
      {
        "id": "dwelling",
        "label": "Logement",
        "questions": [
          {
            "id": "dwelling_type",
            "type": "select",
            "label": "Type de logement",
            "required": true,
            "options": [
              {"id": "house", "label": "Maison"},
              {"id": "apartment", "label": "Appartement"}
            ]
          },
          {
            "id": "position_id",
            "type": "select",
            "label": "Position du logement",
            "required": true,
            "options": [
              {"id": "single_storey_house", "label": "Maison de plain-pied"},
              {"id": "multi_storey_house", "label": "Maison avec etage"},
              {"id": "apartment_top_floor", "label": "Appartement au dernier etage"},
              {"id": "apartment_ground_top_floor", "label": "Appartement en rez-de-chaussee directement sous toiture"}
            ]
          },
          {
            "id": "wall_insulation_id",
            "type": "select",
            "label": "Isolation des murs donnant dehors",
            "required": true,
            "options": [
              {"id": "poor", "label": "Non, ou probablement pas isoles"},
              {"id": "standard", "label": "Je ne sais pas / standard pour l'age du logement"},
              {"id": "renovated", "label": "Oui, isolation ajoutee ou renovee"}
            ]
          },
          {
            "id": "period_id",
            "type": "select",
            "label": "Periode de construction ou renovation",
            "required": true,
            "options_ref": "envelope_defaults"
          },
          {
            "id": "has_cooling",
            "type": "boolean",
            "label": "Le logement a-t-il deja une climatisation active ?",
            "required": false,
            "default": false
          },
          {
            "id": "airtightness_id",
            "type": "select",
            "label": "Etancheite globale du logement",
            "required": true,
            "options": [
              {"id": "leaky", "label": "Courants d'air sensibles"},
              {"id": "standard", "label": "Je ne sais pas / rien de particulier"},
              {"id": "good", "label": "Logement plutot etanche"}
            ]
          },
          {
            "id": "ventilation_id",
            "type": "select",
            "label": "Ventilation principale",
            "required": true,
            "options": [
              {"id": "natural_leaky_old", "label": "Ventilation naturelle logement ancien"},
              {"id": "natural_average", "label": "Ventilation naturelle moyenne"},
              {"id": "simple_flow", "label": "VMC simple flux"},
              {"id": "double_flow_standard", "label": "VMC double flux"},
              {"id": "airtight_recent", "label": "Logement recent etanche"}
            ]
          }
        ]
      },
      {
        "id": "roof",
        "label": "Toiture",
        "questions": [
          {
            "id": "roof_insulation_id",
            "type": "select",
            "label": "Niveau d'isolation toiture actuel",
            "required": true,
            "options": [
              {"id": "poor", "label": "Toiture ou combles peu isoles"},
              {"id": "standard", "label": "Isolation toiture standard"},
              {"id": "renovated", "label": "Toiture bien isolee ou renovee"},
              {"id": "unknown", "label": "Je ne sais pas"}
            ]
          },
          {
            "id": "roof_color_id",
            "type": "select",
            "label": "Couleur dominante actuelle de la toiture",
            "required": true,
            "options": [
              {"id": "dark", "label": "Foncee"},
              {"id": "medium", "label": "Moyenne"},
              {"id": "light", "label": "Claire"},
              {"id": "unknown", "label": "Je ne sais pas"}
            ]
          },
          {
            "id": "attic_ventilation_id",
            "type": "select",
            "label": "Ventilation des combles ou de la sous-toiture",
            "required": true,
            "options": [
              {"id": "ventilated", "label": "Combles ou sous-toiture bien ventiles"},
              {"id": "limited", "label": "Ventilation limitee ou inconnue"},
              {"id": "not_ventilated", "label": "Peu ou pas ventiles"}
            ]
          }
        ]
      },
      {
        "id": "rooms",
        "label": "Pieces sous toiture",
        "questions": [
          {"id": "rooms", "type": "room_list", "label": "Pieces a modeliser, avec contact toiture", "required": true}
        ]
      }
    ]
  }
}
