{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thermaltwin.local/schemas/scenario.schema.json",
  "title": "ThermalTwin scenario MVP schema",
  "description": "Schema for simplified ThermalTwin scenario inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "dwelling_id",
    "timestep_h",
    "setpoints",
    "weather",
    "energy_prices",
    "co2_factors"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "scenario_id": {
      "$ref": "#/$defs/id"
    },
    "dwelling_id": {
      "$ref": "#/$defs/id"
    },
    "description": {
      "type": "string"
    },
    "experiment": {
      "$ref": "#/$defs/experiment"
    },
    "timestep_h": {
      "$ref": "#/$defs/positive_number"
    },
    "initial_temperatures_c": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "setpoints": {
      "$ref": "#/$defs/setpoints"
    },
    "controls": {
      "$ref": "#/$defs/controls"
    },
    "retrofit": {
      "$ref": "#/$defs/retrofit"
    },
    "weather": {
      "$ref": "#/$defs/weather"
    },
    "energy_prices": {
      "$ref": "#/$defs/energy_prices"
    },
    "co2_factors": {
      "$ref": "#/$defs/co2_factors"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_\\-]*$"
    },
    "positive_number": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "non_negative_number": {
      "type": "number",
      "minimum": 0
    },
    "factor_0_1": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adaptation_id",
        "adaptation_label",
        "role",
        "label",
        "season",
        "weather_variant",
        "reason"
      ],
      "properties": {
        "adaptation_id": {
          "$ref": "#/$defs/id"
        },
        "adaptation_label": {
          "type": "string"
        },
        "role": {
          "enum": [
            "primary",
            "secondary",
            "annual"
          ]
        },
        "label": {
          "type": "string"
        },
        "season": {
          "enum": [
            "winter",
            "summer",
            "annual"
          ]
        },
        "weather_variant": {
          "$ref": "#/$defs/id"
        },
        "simulation_type": {
          "enum": [
            "stress",
            "seasonal",
            "annual"
          ]
        },
        "weather_mode": {
          "enum": [
            "synthetic",
            "openmeteo_annual"
          ]
        },
        "requested_city": {
          "type": "string"
        },
        "weather_city": {
          "type": "string"
        },
        "weather_match_mode": {
          "type": "string"
        },
        "weather_year": {
          "type": "integer",
          "minimum": 1940
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "setpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heating_c",
        "cooling_c"
      ],
      "properties": {
        "heating_c": {
          "type": "number"
        },
        "cooling_c": {
          "type": "number"
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shutters": {
          "$ref": "#/$defs/shutter_controls"
        }
      }
    },
    "shutter_controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_opening_ratio": {
          "$ref": "#/$defs/factor_0_1"
        },
        "hourly": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shutter_hourly_control"
          }
        }
      }
    },
    "shutter_hourly_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hour",
        "opening_ratio"
      ],
      "properties": {
        "hour": {
          "type": "integer",
          "minimum": 0
        },
        "opening_ratio": {
          "$ref": "#/$defs/factor_0_1"
        }
      }
    },
    "retrofit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surface_override"
          }
        },
        "window_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/window_override"
          }
        },
        "shutter_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shutter_override"
          }
        },
        "system_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_override"
          }
        },
        "add_systems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_addition"
          }
        }
      }
    },
    "surface_override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id"
      ],
      "properties": {
        "surface_id": {
          "$ref": "#/$defs/id"
        },
        "albedo": {
          "$ref": "#/$defs/factor_0_1"
        },
        "solar_to_room_factor": {
          "$ref": "#/$defs/factor_0_1"
        },
        "u_value_w_m2k": {
          "$ref": "#/$defs/positive_number"
        }
      }
    },
    "window_override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_id"
      ],
      "properties": {
        "window_id": {
          "$ref": "#/$defs/id"
        },
        "window_ref": {
          "$ref": "#/$defs/id"
        },
        "shutter_ref": {
          "$ref": "#/$defs/id"
        },
        "area_m2": {
          "$ref": "#/$defs/positive_number"
        },
        "u_value_w_m2k": {
          "$ref": "#/$defs/positive_number"
        },
        "g_value": {
          "$ref": "#/$defs/factor_0_1"
        },
        "azimuth_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "tilt_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "mask_factor": {
          "$ref": "#/$defs/factor_0_1"
        }
      }
    },
    "shutter_override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_id"
      ],
      "properties": {
        "window_id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "roller_shutter",
            "swing_shutter",
            "blind",
            "external_blind",
            "other"
          ]
        },
        "solar_factor_closed": {
          "$ref": "#/$defs/factor_0_1"
        },
        "solar_factor_open": {
          "$ref": "#/$defs/factor_0_1"
        },
        "u_factor_closed": {
          "$ref": "#/$defs/factor_0_1"
        }
      }
    },
    "system_override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "system_id"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/system_category"
        },
        "system_id": {
          "$ref": "#/$defs/id"
        },
        "system_ref": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "served_rooms": {
          "$ref": "#/$defs/served_rooms"
        },
        "max_power_w": {
          "$ref": "#/$defs/positive_number"
        },
        "performance_ref": {
          "$ref": "#/$defs/system_performance_ref"
        }
      }
    },
    "system_addition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "id",
        "served_rooms",
        "max_power_w"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/system_category"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "system_ref": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "served_rooms": {
          "$ref": "#/$defs/served_rooms"
        },
        "max_power_w": {
          "$ref": "#/$defs/positive_number"
        },
        "performance_ref": {
          "$ref": "#/$defs/system_performance_ref"
        }
      }
    },
    "system_category": {
      "enum": [
        "heating",
        "cooling"
      ]
    },
    "served_rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "system_performance_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/heating_performance_ref"
        },
        {
          "$ref": "#/$defs/cooling_performance_ref"
        }
      ]
    },
    "heating_performance_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "cop"
      ],
      "properties": {
        "mode": {
          "const": "constant"
        },
        "cop": {
          "$ref": "#/$defs/positive_number"
        }
      }
    },
    "cooling_performance_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "eer"
      ],
      "properties": {
        "mode": {
          "const": "constant"
        },
        "eer": {
          "$ref": "#/$defs/positive_number"
        }
      }
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "hourly"
          ]
        },
        {
          "required": [
            "weather_ref"
          ]
        }
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "weather_ref": {
          "type": "string",
          "minLength": 1
        },
        "hourly": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/weather_hour"
          }
        }
      }
    },
    "weather_hour": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hour",
        "outdoor_temperature_c"
      ],
      "properties": {
        "hour": {
          "type": "integer",
          "minimum": 0
        },
        "outdoor_temperature_c": {
          "type": "number"
        },
        "solar_irradiance_w_m2": {
          "$ref": "#/$defs/solar_irradiance"
        }
      }
    },
    "solar_irradiance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "north": {
          "$ref": "#/$defs/non_negative_number"
        },
        "east": {
          "$ref": "#/$defs/non_negative_number"
        },
        "south": {
          "$ref": "#/$defs/non_negative_number"
        },
        "west": {
          "$ref": "#/$defs/non_negative_number"
        },
        "roof": {
          "$ref": "#/$defs/non_negative_number"
        }
      }
    },
    "energy_prices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "electricity_eur_kwh"
      ],
      "properties": {
        "electricity_eur_kwh": {
          "$ref": "#/$defs/non_negative_number"
        }
      }
    },
    "co2_factors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "electricity_kg_kwh"
      ],
      "properties": {
        "electricity_kg_kwh": {
          "$ref": "#/$defs/non_negative_number"
        }
      }
    }
  }
}
