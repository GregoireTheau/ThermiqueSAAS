THERMAL_SAAS_ENV=production
THERMAL_SAAS_SECRET_KEY=change-this-long-random-secret-at-least-32-chars
THERMAL_SAAS_DB_PATH=/app/storage/thermal_saas.sqlite
THERMAL_SAAS_SESSION_TTL_HOURS=12
THERMAL_SAAS_CORS_ORIGINS=https://your-thermaltwin-deployment.example.com
THERMAL_SAAS_ALLOWED_HOSTS=your-thermaltwin-deployment.example.com
THERMAL_SAAS_MAX_REQUEST_BYTES=1000000
THERMAL_SAAS_AUTH_RATE_LIMIT_ATTEMPTS=10
THERMAL_SAAS_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
THERMAL_SAAS_ADMIN_TOKEN=change-this-long-random-admin-token-at-least-32-chars
THERMAL_BACKUP_S3_ENDPOINT=https://s3.example.com
THERMAL_BACKUP_S3_REGION=fr-par
THERMAL_BACKUP_S3_BUCKET=thermal-saas-backups
THERMAL_BACKUP_S3_PREFIX=thermal-saas/sqlite
THERMAL_BACKUP_S3_ACCESS_KEY_ID=change-this-access-key
THERMAL_BACKUP_S3_SECRET_ACCESS_KEY=change-this-secret-key
THERMAL_PDF_BROWSER_PATH=/usr/bin/chromium
THERMAL_WEATHER_DIR=/app/storage/weather
THERMAL_LOCATION_CACHE_DIR=/app/storage/location-cache
THERMAL_NSRDB_API_KEY=change-this-nlr-developer-api-key
THERMAL_NSRDB_EMAIL=weather-downloads@example.com
THERMAL_NSRDB_FULL_NAME=ThermalTwin
THERMAL_NSRDB_AFFILIATION=ThermalTwin
PORT=8000
